ADM -down- CMGMT  : "<size:9>enp7s0\n10.0.0.11</size>"
ADM -down- C1MGMT : "<size:9>enp7s0\n10.0.0.10</size>"
ADM -down- C2MGMT : "<size:9>enp7s0\n10.0.0.12</size>"
