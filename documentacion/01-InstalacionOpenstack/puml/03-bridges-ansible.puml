@startuml
!theme plain
skinparam backgroundColor #FFFFFF
skinparam defaultFontSize 11
skinparam defaultFontName "Arial"
skinparam rectangleBorderColor #555555
skinparam rectangleBorderThickness 1.2
skinparam nodeBorderColor #333333
skinparam nodeBorderThickness 1.8
skinparam arrowColor #444444
skinparam arrowThickness 1.3
skinparam cloudBorderColor #888888
skinparam cloudBorderThickness 1.5

title <b>OpenStack Lab — Arquitectura de Bridges, Interfaces e IPs por Nodo</b>\n<size:10>Estado post Guía-06 · KVM host: ThinkPad L15 Gen 2a · 1 controller + 4 computes</size>

' ============================================================
'  LEYENDA DE COLORES
' ============================================================
legend bottom right
  |= Color |= Capa |
  |<#FFCC80>  NIC física  | enp1s0 / enp7s0 / enp8s0 |
  |<#B3E5FC>  Linux bridge  | br-mgmt / br-vlan / br-vxlan |
  |<#C8E6C9>  OVS bridge  | br-provider / br-int / br-tun |
  |<#FFFDE7>  Red KVM pública  | virbr113 · 203.0.113.0/24 |
  |<#E3F2FD>  Red KVM admin  | virbr10 · 10.0.0.0/24 |
  |<#E8F5E9>  Red KVM provider  | virbr30 · L2 flat |
endlegend

' ============================================================
'  REDES KVM (HOST THINKPAD)
' ============================================================
cloud "<b>openstack-public</b>  [virbr113]\n203.0.113.0/24  gw: 203.0.113.1\nSSH · API · VNC externo" as PUB #FFFDE7

cloud "<b>openstack-admin</b>  [virbr10]\n10.0.0.0/24\nGestión · RabbitMQ · VXLAN underlay" as ADM #E3F2FD

cloud "<b>openstack-provider</b>  [virbr30]\nL2 flat (sin IP en host)\nFloating IPs · Tráfico N-S instancias\nrango: 192.168.122.0/24" as PROV_NET #E8F5E9

' ============================================================
'  CONTROLLER  (serverocontroller)
' ============================================================
node "<b>controller</b>  (serverocontroller)\nKeystone · Glance · Nova-API/Sched/Cond\nNeutron-Server · L3/DHCP/OVS agents\nPlacement · nova-novncproxy" as CTRL #FFF3E0 {

  rectangle "<b>enp1s0</b>  203.0.113.239/24\ngw: 203.0.113.1" as CE1 #FFCC80
  rectangle "<b>enp7s0</b>  (sin IP)\nmiembro → br-mgmt" as CE7 #FFCC80
  rectangle "<b>enp8s0</b>  (sin IP)\nmiembro → br-vlan" as CE8 #FFCC80

  rectangle "<b>br-mgmt</b>  10.0.0.11/24\nLinux bridge  ←  enp7s0\nGestión / APIs / RabbitMQ" as CMGMT #B3E5FC
  rectangle "<b>br-vlan</b>  (sin IP)\nLinux bridge  ←  enp8s0\nUplink físico provider" as CVLAN #B3E5FC
  rectangle "<b>br-vxlan</b>  10.0.0.11/32 ★\nLinux bridge (sin NIC física)\nTunnel bridge OSA" as CVXLAN #B3E5FC

  rectangle "<b>OVS br-provider</b>\nuplink: br-vlan ✓\nphy-br-provider (patch→br-int)" as COVSP #C8E6C9
  rectangle "<b>OVS br-int</b>\ntap DHCP · qr-port · qg-port\nint-br-provider (patch←br-prov)" as COVSI #C8E6C9
  rectangle "<b>OVS br-tun</b>  local_ip: 10.0.0.11\nvxlan-0a00000a (→compute1)\npatch-int ↔ patch-tun" as COVST #C8E6C9
}

