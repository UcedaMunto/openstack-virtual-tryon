node "<b>compute1</b>  (10.0.0.10 / 203.0.113.240)\nnova-compute · neutron-openvswitch-agent\nlibvirtd / KVM" as C1 #EDE7F6 {
  rectangle "<b>enp1s0</b>  203.0.113.240/24" as C1E1 #FFCC80
  rectangle "<b>enp7s0</b>  (sin IP)  →br-mgmt" as C1E7 #FFCC80
  rectangle "<b>enp8s0</b>  (sin IP)  →br-vlan" as C1E8 #FFCC80
  rectangle "<b>br-mgmt</b>  10.0.0.10/24  ←enp7s0" as C1MGMT #B3E5FC
  rectangle "<b>br-vlan</b>  (sin IP)  ←enp8s0" as C1VLAN #B3E5FC
  rectangle "<b>br-vxlan</b>  10.0.0.10/32 ★  (sin NIC)" as C1VXLAN #B3E5FC
  rectangle "<b>OVS br-provider</b>  uplink: br-vlan ✓" as C1OVSP #C8E6C9
  rectangle "<b>OVS br-int</b>  tap instancias" as C1OVSI #C8E6C9
  rectangle "<b>OVS br-tun</b>  local_ip: 10.0.0.10" as C1OVST #C8E6C9
}

