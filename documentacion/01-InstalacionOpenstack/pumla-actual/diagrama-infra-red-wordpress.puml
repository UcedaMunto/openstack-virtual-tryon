node "controller\n203.0.113.239\nbr-mgmt 10.0.0.11\nNeutron L3/DHCP/OVS" as CTRL {
  rectangle "OVS br-provider/br-int/br-tun\nVXLAN peers: 10.0.0.10, 10.0.0.12" as COVS
  rectangle "qrouter-926f...\nqdhcp-7c22..., qdhcp-bfb7..." as CNS
  rectangle "DNAT host :8080" as DNAT
}

node "compute2\n203.0.113.241\nbr-mgmt 10.0.0.12" as C2 {
  node "wp-web-01\n10.10.10.76\nFIP 192.168.122.137" as WPWEB
  node "wp-db-01\n10.10.10.152\nFIP 192.168.122.152" as WPDB
}

node "compute1\n203.0.113.240\nbr-mgmt 10.0.0.10" as C1 {
  node "test-vm1\n10.10.10.229\nFIP 192.168.122.115\nSHUTOFF" as TVM1
}

node "compute3\n203.0.113.242" as C3
node "compute4\n203.0.113.243" as C4
node "storage1\n203.0.113.244\n10.0.0.15\nCinder/Ceph" as ST1
node "object1\n203.0.113.245\n10.0.0.51\nSwift" as O1
node "object2\n203.0.113.246\n10.0.0.52\nSwift" as O2

PUB -- CTRL
PUB -- C1
PUB -- C2
PUB -- C3
PUB -- C4
PUB -- ST1
