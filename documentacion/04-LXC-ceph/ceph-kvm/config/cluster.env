# Ceph KVM cluster configuration

# VM image and storage
BASE_IMAGE_URL="https://cloud-images.ubuntu.com/jammy/current/jammy-server-cloudimg-amd64.img"
WORKDIR="/var/tmp/ceph-kvm"
BASE_IMAGE="${WORKDIR}/images/jammy-server-cloudimg-amd64.img"

# SSH user created by cloud-init
SSH_USER="ubuntu"
SSH_PRIVATE_KEY="${HOME}/.ssh/id_rsa"
SSH_PUBLIC_KEY="${HOME}/.ssh/id_rsa.pub"

# VM sizing
VM_CPUS=2
VM_MEMORY_MB=4096
OSD_DATA_DISK_GB=20

# Libvirt network names
ADMIN_NET_NAME="ceph-admin-net"
DATA_NET_NAME="ceph-data-net"

# Network CIDRs
ADMIN_NET_CIDR="192.168.130.0/24"
DATA_NET_CIDR="192.168.140.0/24"

# Static IPs
CEPH_ADMIN_IP="192.168.130.100"
CEPH_MON_IP="192.168.130.10"
CEPH_1_ADMIN_IP="192.168.130.11"
CEPH_2_ADMIN_IP="192.168.130.12"
CEPH_3_ADMIN_IP="192.168.130.13"

CEPH_1_DATA_IP="192.168.140.11"
CEPH_2_DATA_IP="192.168.140.12"
CEPH_3_DATA_IP="192.168.140.13"

# Dashboard
DASHBOARD_USER="admin"
DASHBOARD_PASSWORD="AdminCeph2026!"
DASHBOARD_PORT="8443"
