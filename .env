# =====================================================================
#  .env — Inventario de red de la plataforma (3 nodos físicos, 1 sitio)
# ---------------------------------------------------------------------
#  Este archivo es la ÚNICA fuente de verdad para las IPs y nombres de
#  los 3 hosts físicos. Los playbooks Ansible, el inventario de
#  Kolla-Ansible, los manifests de Kubernetes y los diagramas hacen
#  referencia a estas variables.
# ---------------------------------------------------------------------
#  Método OpenStack : Kolla-Ansible
#  Orquestación     : Kubernetes
#  GPU              : 1 sola (NODE-03)
#  Topología        : red local única (sin WireGuard / sin multi-sitio)
# =====================================================================

# ---------- Identidad de los 3 hosts físicos --------------------------
NODE01_NAME=node-01
NODE01_ROLE=control+network+compute-cpu
NODE01_GPU=false

NODE02_NAME=node-02
NODE02_ROLE=compute-cpu+storage-datos
NODE02_GPU=false

NODE03_NAME=node-03
NODE03_ROLE=compute-gpu
NODE03_GPU=true

# ---------- Red de Management / API (control) -------------------------
# VLAN 10 · aquí viven el control plane de Kolla y el acceso SSH/Ansible
MGMT_SUBNET=10.10.0.0/24
MGMT_GATEWAY=10.10.0.1
MGMT_VIP=10.10.0.10
NODE01_MGMT_IP=10.10.0.11
NODE02_MGMT_IP=10.10.0.12
NODE03_MGMT_IP=10.10.0.13

# ---------- Red de Almacenamiento (storage / Cinder) ------------------
# VLAN 30 · tráfico de volúmenes y replicación
STORAGE_SUBNET=10.10.2.0/24
NODE01_STORAGE_IP=10.10.2.11
NODE02_STORAGE_IP=10.10.2.12
NODE03_STORAGE_IP=10.10.2.13

# ---------- Red de túneles (Neutron VXLAN) ----------------------------
# VLAN 40 · tráfico de overlay entre compute nodes
TUNNEL_SUBNET=10.10.3.0/24
NODE01_TUNNEL_IP=10.10.3.11
NODE02_TUNNEL_IP=10.10.3.12
NODE03_TUNNEL_IP=10.10.3.13

# ---------- Red externa / flotante (br-ex) ----------------------------
# VLAN 50 · IPs públicas/flotantes que Neutron asigna a las VMs
EXTERNAL_SUBNET=10.10.4.0/24
EXTERNAL_GATEWAY=10.10.4.1
FLOATING_RANGE_START=10.10.4.100
FLOATING_RANGE_END=10.10.4.200

# ---------- Estación administrativa (control Ansible) -----------------
# Vive FUERA del dominio que administra, para poder reconstruir los nodos
ADMIN_NAME=admin-workstation
ADMIN_IP=10.10.0.5

# ---------- DNS / NTP -------------------------------------------------
DNS_SERVERS=10.10.0.1
NTP_SERVERS=10.10.0.1

# ---------- Dominio interno -------------------------------------------
DOMAIN=tryon.local
