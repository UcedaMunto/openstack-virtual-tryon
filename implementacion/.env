# =============================================================================
# .env — IPs y nombres de los 3 hosts (fuente de verdad de la red)
# -----------------------------------------------------------------------------
#  Equivalente a:  inventory/nodes.env  y  ansible/group_vars/physical_nodes.yml
#  Para otra red/empresa: editar solo aquí y replicar en los otros dos archivos.
# =============================================================================

SSH_USER=uceda

# ---- NODO-01 : control + network + compute CPU -------------------------------
NODE01_NAME=anfitrion
NODE01_IP=192.168.0.10
NODE01_ROLE=control

# ---- NODO-02 : compute CPU + storage -----------------------------------------
NODE02_NAME=asus-tuf
NODE02_IP=192.168.0.126
NODE02_ROLE=compute

# ---- NODO-03 : compute GPU (IA) ----------------------------------------------
NODE03_NAME=server
NODE03_IP=192.168.0.100
NODE03_ROLE=gpu

# ---- Derivados ---------------------------------------------------------------
CONTROL_NODE=192.168.0.10
GPU_NODE=192.168.0.100
KOLLA_VIP=192.168.0.200
