# =============================================================================
#  nodes.env — Fuente de verdad de la red (UNICO archivo a editar por red)
# -----------------------------------------------------------------------------
#  Para desplegar en OTRA red: cambiar solo IPs/nombres/roles y la contraseña
#  sudo del bootstrap. El resto de scripts leen de aquí.
#  Objetivo: Ubuntu 24.04 en los 3 nodos.
# =============================================================================

SSH_USER=uceda
SSH_KEY="$HOME/.ssh/id_ed25519"

# Contraseña sudo (SOLO la usa 00-bootstrap.sh para habilitar NOPASSWD).
# Para otra red: export SUDO_PASSWORD=... antes de ejecutar, o editar aquí.
SUDO_PASSWORD="${SUDO_PASSWORD:-asdfghjkl}"

# ---- NODO-01 : control + network + compute CPU ------------------------------
NODE01_NAME=anfitrion
NODE01_IP=192.168.0.10
NODE01_ROLE=control

# ---- NODO-02 : compute CPU + storage ----------------------------------------
NODE02_NAME=asus-tuf
NODE02_IP=192.168.0.126
NODE02_ROLE=compute

# ---- NODO-03 : compute GPU (IA) ---------------------------------------------
NODE03_NAME=server
NODE03_IP=192.168.0.100
NODE03_ROLE=gpu

# ---- Listas derivadas -------------------------------------------------------
CONTROL_NODE="$NODE01_IP"      # nodo de control Ansible/Kolla (donde se corre)
GPU_NODE="$NODE03_IP"          # nodo con GPU NVIDIA
COMPUTE_NODES="$NODE02_IP"     # computes CPU
ALL_NODES="$NODE01_IP $NODE02_IP $NODE03_IP"

# Versiones objetivo (alineadas con el laboratorio de referencia)
KUBE_VERSION="v1.36"
KOLLA_VENV="/opt/kolla-ansible"
KOLLA_CONFIG_DIR="/etc/kolla"

# ---- Interfaces de red (NIC) por nodo (nombres reales de cada máquina) ------
NODE01_NIC=enp2s0f0
NODE02_NIC=enp2s0
NODE03_NIC=eno1

# ---- VIP interna de Kolla (debe ser una IP LIBRE de la red 192.168.0.0/24) --
KOLLA_VIP=192.168.0.200
